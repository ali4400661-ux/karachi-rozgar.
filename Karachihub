<!DOCTYPE html>
<html lang="ur" dir="rtl" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karachi Rozgar - All-in-One VIP Service & Emergency Hub</title>
    <meta name="theme-color" content="#0284c7">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="manifest" href="manifest.json">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f8fafc;
            --text-color: #1e293b;
            --box-bg: #ffffff;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --input-bg: #f8fafc;
            --primary: #0284c7;
            --primary-gradient: linear-gradient(135deg, #0284c7, #4f46e5);
            --success: #16a34a;
        }
        body {
            font-family: 'Noto Nastaliq Urdu', 'Segoe UI', Tahoma, sans-serif;
            background-color: var(--bg-color);
            margin: 0; padding: 0; color: var(--text-color);
        }
        header {
            background: var(--primary-gradient);
            color: white; text-align: center; padding: 25px 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        header h1 { margin: 0; font-size: 22px; }
        header p { margin: 6px 0 0; font-size: 12px; opacity: 0.95; }
        .container { width: 92%; max-width: 900px; margin: 20px auto; }
        .box {
            background: var(--box-bg); border: 1px solid var(--border-color);
            padding: 18px; border-radius: 12px; margin-bottom: 18px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }
        input, select, textarea {
            width: 100%; padding: 12px; margin: 6px 0;
            border: 1px solid var(--border-color); border-radius: 8px;
            box-sizing: border-box; font-size: 14px; background-color: var(--input-bg); color: var(--text-color);
        }
        button.btn-main {
            background-color: var(--success); color: white; border: none;
            padding: 12px; font-size: 15px; cursor: pointer; border-radius: 8px; width: 100%; font-weight: bold;
        }
        .workers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 15px; }
        .worker-card {
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 12px; padding: 15px; text-align: center; border-top: 5px solid #16a34a;
        }
        .worker-img { width: 100%; height: 140px; object-fit: cover; border-radius: 8px; margin-bottom: 8px; }
        .booking-btn {
            background-color: #f97316; color: white; border: none;
            padding: 10px; border-radius: 8px; font-size: 13px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 8px;
        }
        footer { text-align: center; padding: 20px; background-color: #0f172a; color: #94a3b8; font-size: 12px; margin-top: 30px; }
    </style>
</head>
<body>

    <header>
        <h1>Karachi Rozgar Hub</h1>
        <p>Mistri, Mazdoor, Electrician aur Emergency Services</p>
    </header>

    <div class="container">
        <div class="box">
            <h3 style="margin-top:0; font-size:16px;">🔍 Talash Karein</h3>
            <input type="text" id="searchNameInput" placeholder="Naam ya kaam likhein..." onkeyup="filterWorkers()">
            
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                <select id="filterLocation" onchange="filterWorkers()" style="flex:1;">
                    <option value="">Tamam Ilaqay (Karachi)</option>
                    <option value="Baldia Town">Baldia Town</option>
                    <option value="Orangi Town">Orangi Town</option>
                    <option value="Saddar">Saddar</option>
                    <option value="Gulshan-e-Iqbal">Gulshan-e-Iqbal</option>
                    <option value="Nazimabad">Nazimabad</option>
                </select>
                <select id="filterCategory" onchange="filterWorkers()" style="flex:1;">
                    <option value="">Tamam Categories</option>
                    <option value="Mistri">Mistri</option>
                    <option value="Mazdoor">Mazdoor</option>
                    <option value="Electrician">Electrician</option>
                    <option value="Plumber">Plumber</option>
                </select>
            </div>
        </div>

        <div class="box">
            <h2 style="margin-top:0; font-size:18px;">✨ Apni Profile Darj Karein</h2>
            <form id="workerForm">
                <input type="text" id="name" placeholder="Aap ka naam" required>
                <select id="category" required>
                    <option value="">Shuba muntakhib karein</option>
                    <option value="Mistri">Mistri</option>
                    <option value="Mazdoor">Mazdoor</option>
                    <option value="Electrician">Electrician</option>
                    <option value="Plumber">Plumber</option>
                </select>
                <select id="location" required>
                    <option value="">Ilaqa muntakhib karein</option>
                    <option value="Baldia Town">Baldia Town</option>
                    <option value="Orangi Town">Orangi Town</option>
                    <option value="Saddar">Saddar</option>
                    <option value="Gulshan-e-Iqbal">Gulshan-e-Iqbal</option>
                    <option value="Nazimabad">Nazimabad</option>
                </select>
                <input type="text" id="rate" placeholder="Muawza (misal: 1500 rupay)" required>
                <input type="tel" id="phone" placeholder="WhatsApp number (03001234567)" required>
                <input type="file" id="workerImage" accept="image/*" style="margin-top:8px;">
                <textarea id="details" placeholder="Mazeed tafseel..."></textarea>
                <button type="submit" class="btn-main" style="margin-top:10px;">Muft Register Karein</button>
            </form>
        </div>

        <h2 style="font-size:18px; margin-bottom:12px;">📋 Dastyab Khidmat</h2>
        <div class="workers-grid" id="workersContainer">
            <p style="text-align:center; color:#777; grid-column:1/-1;">⏳ Loading...</p>
        </div>
    </div>

    <footer><p>© 2026 Karachi Rozgar Hub. Tamam huqooq mehfooz hain.</p></footer>

    <script>
        const SHEET_API_URL = "https://script.google.com/macros/s/AKfycbx3NLatXjp3IXj8J5E1uZrl-tOcXZvmmNwKslgP-TiS2BbJNUg6MPAKOReTvvJhlBwr/exec";
        let workers = [];

        window.onload = function() { fetchWorkers(); };

        async function fetchWorkers() {
            try {
                let res = await fetch(SHEET_API_URL);
                let data = await res.json();
                if (Array.isArray(data)) { workers = data; filterWorkers(); }
            } catch (err) { console.error(err); }
        }

        window.filterWorkers = function() {
            let search = document.getElementById('searchNameInput').value.toLowerCase();
            let loc = document.getElementById('filterLocation').value;
            let cat = document.getElementById('filterCategory').value;
            let container = document.getElementById('workersContainer');

            let filtered = workers.filter(w => {
                let matchSearch = !search || (w.name && w.name.toLowerCase().includes(search));
                let matchLoc = !loc || w.location === loc;
                let matchCat = !cat || w.category === cat;
                return matchSearch && matchLoc && matchCat;
            });

            if (filtered.length === 0) {
                container.innerHTML = `<p style="text-align:center; color:#777; grid-column:1/-1;">Koi record nahi mila.</p>`;
                return;
            }

            let html = "";
            filtered.forEach(w => {
                let phoneFormatted = String(w.phone || '').replace(/^0/, '92');
                html += `
                    <div class="worker-card">
                        ${w.imageUrl ? `<img src="${w.imageUrl}" class="worker-img">` : ''}
                        <h3 style="margin:5px 0; color:var(--primary);">${w.name}</h3>
                        <p style="margin:4px 0; font-size:13px;"><strong>Shuba:</strong> ${w.category}</p>
                        <p style="margin:4px 0; font-size:13px;"><strong>Ilaqa:</strong> ${w.location}</p>
                        <p style="margin:4px 0; font-size:13px;"><strong>Rate:</strong> ${w.rate}</p>
                        <button class="booking-btn" onclick="window.open('https://wa.me/${phoneFormatted}?text=Salam! Mujhe aap ki service chahiye.', '_blank')">📞 WhatsApp Rabta</button>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        document.getElementById('workerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            let name = document.getElementById('name').value;
            let phone = document.getElementById('phone').value;
            let imageFile = document.getElementById('workerImage').files[0];

            let reader = new FileReader();
            reader.onload = async function(event) {
                let payload = {
                    action: "addWorker", id: "ID_" + Date.now(), name: name,
                    category: document.getElementById('category').value,
                    location: document.getElementById('location').value,
                    rate: document.getElementById('rate').value,
                    phone: phone, imageUrl: event.target.result || "",
                    details: document.getElementById('details').value, status: 'pending'
                };
                await fetch(SHEET_API_URL, { method: "POST", body: JSON.stringify(payload) });
                alert("Profile kamiyabi se jama ho gayi hai!");
                document.getElementById('workerForm').reset(); fetchWorkers();
            };
            if (imageFile) reader.readAsDataURL(imageFile);
            else {
                let payload = {
                    action: "addWorker", id: "ID_" + Date.now(), name: name,
                    category: document.getElementById('category').value,
                    location: document.getElementById('location').value,
                    rate: document.getElementById('rate').value,
                    phone: phone, imageUrl: "",
                    details: document.getElementById('details').value, status: 'pending'
                };
                await fetch(SHEET_API_URL, { method: "POST", body: JSON.stringify(payload) });
                alert("Profile kamiyabi se jama ho gayi hai!");
                document.getElementById('workerForm').reset(); fetchWorkers();
            }
        });
    </script>
</body>
</html>
